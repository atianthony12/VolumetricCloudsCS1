  <!-- ==================== The settings file (VolumetricClouds.xml) ==================== -->
  <!-- Comments the mod writes into the player's settings file. The names of the settings in
       that file are not translated. -->

  <!-- One line of the file per \n: a bullet wrapped here stays one line there. -->
  <String key="File.Header">
    Volumetric Weather settings.\n
    \n
    You can edit this file while the game is running: the mod reads it again within a
    second of it being saved, and the panels follow.\n
    \n
    - Numbers use a dot for decimals: 0.5, never 0,5.\n
    - A percentage is written the way its slider shows it: 47 means 47%.\n
    - A value outside its range is pulled back into it. A value that cannot be read, and a
    name the mod does not know, are ignored. VolumetricClouds.log says which.\n
    - A setting whose line is missing keeps the value it has (at startup, its default).\n
    - If the file cannot be read at all, the mod leaves it alone and says so in the log.\n
    - The mod rewrites this file, these comments included, whenever a setting changes in
    the game: notes of your own will not survive.\n
    - Delete the file with the game closed to start again from every default.
  </String>
  <String key="File.Section.Panel">In-game panel: {0} tab</String>
  <String key="File.Section.Advanced">In-game panel, with advanced options on: {0} tab</String>
  <String key="File.Section.Options">The game's options page</String>
  <String key="File.Section.None">Not shown on either page</String>
  <String key="File.Percent">{0}, in %. {1} to {2}, default {3}.</String>
  <String key="File.Number">{0}. {1} to {2}{3}, default {4}.</String>
  <String key="File.AnyNumber">{0}. Default {1}.</String>
  <String key="File.Readout">(slider: {0} to {1})</String>
  <String key="File.Toggle">{0}. true or false, default {1}.</String>
  <String key="File.Choice">{0}. One of {1}; default {2}.</String>
  <String key="File.Key">{0}. A key such as F4 or Ctrl+Shift+C, or None; default {1}.</String>
  <String key="File.Colour">{0}. A color, #RRGGBB (255, 192, 203 is read too); default {1}.</String>
  <String key="File.Text">{0}.</String>

  <!-- The header of a profile's file (VolumetricCloudsProfiles\<name>.xml): one line per \n. -->
  <String key="File.ProfileHeader">
    Volumetric Weather profile: a whole sky, saved under the name of this file.\n
    \n
    Pick it at the top of the mod's in-game panel. The panel's Save button writes the sky you
    have into this file; nothing else in the game changes it.\n
    \n
    - To share the sky, copy this file into the VolumetricCloudsProfiles folder of another
    computer. Rename the file to rename the profile.\n
    - It holds every setting of the sky except the Now tab's, which are the weather of the moment.
    The settings that describe the computer (quality, language, keys, the button) are left out on
    purpose, and so is a city's cloud pattern, which is kept in the city's save.\n
    - A setting missing from this file goes back to its default when the profile is picked.\n
    - The rules of VolumetricClouds.xml apply here too: a dot for decimals, percentages written
    the way the slider shows them, a value out of range pulled back into it.\n
    - You can edit this file while the game is running. If it is the picked profile, the mod puts
    your edit in within a second of it being saved; otherwise the edit is used when you pick it.
    If it cannot be read at all, the mod leaves it alone and says so in the log.
  </String>

</Language>
